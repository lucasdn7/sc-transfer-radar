# URL da API do servidor Express para Google Sheets.
# Defina-a somente quando o servidor API estiver disponível. Para desenvolvimento
# local, inicie `npm run api` e use: http://localhost:3001.
# Para produção, use a URL pública do servidor. Sem esta variável, o envio à
# planilha é ignorado e o formulário não tenta acessar localhost no navegador.
# VITE_API_URL=http://localhost:3001

# URL do mapa interativo externo hospedado no Vercel
# Se não definida, usa o valor padrão: https://mapa-de-convenios.vercel.app/
# VITE_MAPA_URL=https://mapa-de-convenios.vercel.app/

# Configurações para integração com GitHub Actions (contract-notifier)
# GITHUB_TOKEN=seu_github_token_aqui
# GITHUB_OWNER=lucasdn7
# GITHUB_REPO=contract-notifier

# Outras variáveis de ambiente do projeto...
# (adicionar as variáveis existentes aqui)
