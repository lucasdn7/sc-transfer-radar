<script>
  const CONFIG = {
    // Supabase
    SUPABASE_URL:     'https://SEU_PROJETO.supabase.co',
    SUPABASE_KEY:     'SUA_SUPABASE_ANON_KEY',

    // Webhook N8N para verificação individual
    N8N_WEBHOOK_URL:  'https://SEU_N8N/webhook/dart-verificar',

    // Delay entre requests ao "Verificar Todos" (ms)
    DELAY_ENTRE_REQUESTS: 2000,
  };
</script>

<!-- ============================================================
     HTML
============================================================ -->
<div class="dart-header">
  <div class="header-left">
    <span class="dart-badge">DART</span>
    <div>
      <div class="header-title">Verificação de Regularidade</div>
      <div class="header-subtitle">Situação dos municípios junto aos credores</div>
    </div>
  </div>
  <div class="header-right">
    <div class="ultima-verificacao" id="ultima-verificacao">
      Última verificação em lote: <span id="ultima-data">—</span>
    </div>
    <button class="btn btn-primary" id="btn-verificar-todos" onclick="verificarTodos()">
      <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
