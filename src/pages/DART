<!-- ============================================================
     JAVASCRIPT
============================================================ -->
<script>
  // ── Estado global
  let municipios       = [];
  let filtroAtual      = 'all';
  let buscaAtual       = '';
  let verificandoTodos = false;

  // ── Inicialização
  document.addEventListener('DOMContentLoaded', () => {
    carregarMunicipios();
  });

  // ── Helpers: formatar CNPJ
  function formatarCNPJ(cnpj) {
    const c = cnpj.replace(/\D/g, '');
    if (c.length !== 14) return cnpj;
    return c.replace(/(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/, '$1.$2.$3/$4-$5');
  }

  // ── Helpers: formatar data
  function formatarData(iso) {
    if (!iso) return '—';
    const [y, m, d] = iso.split('T')[0].split('-');
    return `${d}/${m}/${y}`;
  }

  // ── Helpers: formatar timestamp relativo
  function tempoRelativo(iso) {
    if (!iso) return 'Nunca';
    const diff = Date.now() - new Date(iso).getTime();
    const min  = Math.floor(diff / 60000);
    if (min < 1)   return 'agora';
    if (min < 60)  return `há ${min}min`;
    const h = Math.floor(min / 60);
    if (h < 24)    return `há ${h}h`;
    const d = Math.floor(h / 24);
    return `há ${d}d`;
  }

  // ── Helpers: label de status
  function labelStatus(status) {
    const labels = {
      regular:   'Regular',
      irregular: 'Irregular',
      pending:   'Pendente',
      error:     'Erro',
      checking:  'Verificando...'
    };
    return labels[status] || 'Pendente';
  }

  // ── Carregar municípios do Supabase
  async function carregarMunicipios() {
    try {
      const resp = await fetch(
        `${CONFIG.SUPABASE_URL}/rest/v1/municipalities?select=id,name,cnpj,dart_status,dart_validade,dart_verificado_em&cnpj=not.is.null&order=name`,
        {
          headers: {
            'apikey': CONFIG.SUPABASE_KEY,
            'Authorization': `Bearer ${CONFIG.SUPABASE_KEY}`
          }
        }
      );

      if (!resp.ok) throw new Error(`Supabase error: ${resp.status}`);
      municipios = await resp.json();

      renderTabela();
      atualizarStats();
      atualizarUltimaVerificacao();

    } catch (err) {
      console.error(err);
      mostrarToast('Erro ao carregar municípios: ' + err.message, 'error');
      document.getElementById('dart-tbody').innerHTML = `
        <tr><td colspan="6">
          <div class="empty-state">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <p>Erro ao conectar com o Supabase.<br>Verifique as configurações em CONFIG.</p>
          </div>
        </td></tr>`;
    }
  }

  // ── Renderizar tabela com filtros aplicados
  function renderTabela() {
    const busca = buscaAtual.toLowerCase().trim();
    const filtrados = municipios.filter(m => {
      const matchBusca = !busca ||
        m.name.toLowerCase().includes(busca) ||
        (m.cnpj || '').replace(/\D/g,'').includes(busca.replace(/\D/g,''));
      const status = m.dart_status || 'pending';
      const matchFiltro = filtroAtual === 'all' || status === filtroAtual;
      return matchBusca && matchFiltro;
    });

    const tbody = document.getElementById('dart-tbody');

    if (filtrados.length === 0) {
      tbody.innerHTML = `
        <tr><td colspan="6">
          <div class="empty-state">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <p>Nenhum município encontrado.</p>
          </div>
        </td></tr>`;
      return;
    }

    tbody.innerHTML = filtrados.map(m => {
      const status   = m.dart_status || 'pending';
      const cnpjFmt  = m.cnpj ? formatarCNPJ(m.cnpj) : '—';
      const validade = formatarData(m.dart_validade);
      const tempo    = tempoRelativo(m.dart_verificado_em);

      return `<tr id="row-${m.id}">
        <td class="td-municipio">${escapeHtml(m.name)}</td>
        <td class="td-cnpj">${cnpjFmt}</td>
        <td>
          <span class="status-badge ${status}" id="badge-${m.id}">
            ${labelStatus(status)}
          </span>
        </td>
        <td class="td-validade" id="validade-${m.id}">${validade}</td>
        <td class="td-verificado" id="tempo-${m.id}">${tempo}</td>
        <td>
          <button class="btn btn-ghost btn-sm" id="btn-${m.id}"
            onclick="verificarUm('${m.id}','${m.cnpj}','${escapeHtml(m.name)}')">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Verificar
          </button>
        </td>
      </tr>`;
    }).join('');
  }

  // ── Atualizar cards de estatísticas
  function atualizarStats() {
    const total     = municipios.length;
    const regular   = municipios.filter(m => m.dart_status === 'regular').length;
    const irregular = municipios.filter(m => m.dart_status === 'irregular').length;
    const pending   = municipios.filter(m => !m.dart_status || m.dart_status === 'pending' || m.dart_status === 'error').length;

    document.getElementById('stat-total').textContent     = total;
    document.getElementById('stat-regular').textContent   = regular;
    document.getElementById('stat-irregular').textContent = irregular;
    document.getElementById('stat-pending').textContent   = pending;
  }

  // ── Atualizar timestamp última verificação em lote
  function atualizarUltimaVerificacao() {
    const comData = municipios.filter(m => m.dart_verificado_em).sort(
      (a, b) => new Date(b.dart_verificado_em) - new Date(a.dart_verificado_em)
    );
    const el = document.getElementById('ultima-data');
    if (comData.length > 0) {
      const dt = new Date(comData[0].dart_verificado_em);
      el.textContent = dt.toLocaleString('pt-BR', {
        day: '2-digit', month: '2-digit', year: 'numeric',
        hour: '2-digit', minute: '2-digit'
      });
    } else {
      el.textContent = '—';
    }
  }

  // ── Filtrar tabela
  function filtrarTabela() {
    buscaAtual = document.getElementById('search-input').value;
    renderTabela();
  }

  // ── Trocar filtro de status
  function setFiltro(filtro, btn) {
    filtroAtual = filtro;
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderTabela();
  }

  // ── Verificar um município específico
  async function verificarUm(id, cnpj, nome) {
    const btn    = document.getElementById(`btn-${id}`);
    const badge  = document.getElementById(`badge-${id}`);

    btn.disabled = true;
    btn.innerHTML = '<div class="spinner"></div> Verificando...';
    badge.className = 'status-badge checking';
    badge.textContent = 'Verificando...';

    try {
      const resp = await fetch(CONFIG.N8N_WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ municipality_id: id, cnpj, name: nome })
      });

      if (!resp.ok) throw new Error(`Webhook error: ${resp.status}`);
      const resultado = await resp.json();

      // Atualiza o objeto local
      const idx = municipios.findIndex(m => m.id === id);
      if (idx !== -1) {
        municipios[idx].dart_status        = resultado.status;
        municipios[idx].dart_validade      = resultado.validade;
        municipios[idx].dart_verificado_em = new Date().toISOString();
      }

      // Atualiza a linha na tabela
      badge.className = `status-badge ${resultado.status}`;
      badge.textContent = labelStatus(resultado.status);

      const validadeEl = document.getElementById(`validade-${id}`);
      if (validadeEl) validadeEl.textContent = formatarData(resultado.validade);

      const tempoEl = document.getElementById(`tempo-${id}`);
      if (tempoEl) tempoEl.textContent = 'agora';

      atualizarStats();
      mostrarToast(`${nome}: ${labelStatus(resultado.status)}`, resultado.status === 'regular' ? 'success' : 'info');

    } catch (err) {
      console.error(err);
      badge.className = 'status-badge error';
      badge.textContent = 'Erro';
      mostrarToast(`Erro ao verificar ${nome}: ${err.message}`, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = `
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
        Verificar`;
    }
  }

  // ── Verificar todos (com throttle)
  async function verificarTodos() {
    if (verificandoTodos) return;
    if (!confirm(`Isso irá verificar ${municipios.length} municípios com um intervalo de ${CONFIG.DELAY_ENTRE_REQUESTS/1000}s entre cada.\n\nDeseja continuar?`)) return;

    verificandoTodos = true;
    const btnTodos = document.getElementById('btn-verificar-todos');
    btnTodos.disabled = true;
    btnTodos.innerHTML = '<div class="spinner"></div> Verificando...';

    const progressWrap = document.getElementById('progress-wrap');
    progressWrap.classList.add('visible');

    const total = municipios.length;
    let concluidos = 0;

    for (const m of municipios) {
      document.getElementById('progress-texto').textContent = `Verificando: ${m.name}`;
      document.getElementById('progress-num').textContent   = `${concluidos} / ${total}`;
      document.getElementById('progress-fill').style.width  = `${(concluidos / total) * 100}%`;

      try {
        const resp = await fetch(CONFIG.N8N_WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ municipality_id: m.id, cnpj: m.cnpj, name: m.name })
        });

        if (resp.ok) {
          const resultado = await resp.json();
          const idx = municipios.findIndex(x => x.id === m.id);
          if (idx !== -1) {
            municipios[idx].dart_status        = resultado.status;
            municipios[idx].dart_validade      = resultado.validade;
            municipios[idx].dart_verificado_em = new Date().toISOString();
          }

          // Atualiza a linha se visível
          const badge = document.getElementById(`badge-${m.id}`);
          if (badge) {
            badge.className = `status-badge ${resultado.status}`;
            badge.textContent = labelStatus(resultado.status);
          }
          const validadeEl = document.getElementById(`validade-${m.id}`);
          if (validadeEl) validadeEl.textContent = formatarData(resultado.validade);
          const tempoEl = document.getElementById(`tempo-${m.id}`);
          if (tempoEl) tempoEl.textContent = 'agora';
        }
      } catch (err) {
        console.error(`Erro em ${m.name}:`, err);
      }

      concluidos++;
      await sleep(CONFIG.DELAY_ENTRE_REQUESTS);
    }

    // Finalizado
    document.getElementById('progress-fill').style.width  = '100%';
    document.getElementById('progress-num').textContent   = `${total} / ${total}`;
    document.getElementById('progress-texto').textContent = 'Verificação concluída!';

    atualizarStats();
    atualizarUltimaVerificacao();
    renderTabela();
    mostrarToast(`Verificação concluída: ${total} municípios processados.`, 'success');

    setTimeout(() => {
      progressWrap.classList.remove('visible');
      verificandoTodos = false;
      btnTodos.disabled = false;
      btnTodos.innerHTML = `
        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
        Verificar Todos`;
    }, 3000);
  }

  // ── Toast notification
  function mostrarToast(msg, tipo = 'info') {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    toast.className = `toast ${tipo}`;
    toast.innerHTML = `
      ${tipo === 'success' ? '✓' : tipo === 'error' ? '✕' : 'ℹ'}
      <span>${msg}</span>`;
    container.appendChild(toast);
    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transition = 'opacity 0.3s';
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  }

  // ── Utils
  function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
</script>
</body>
</html>
